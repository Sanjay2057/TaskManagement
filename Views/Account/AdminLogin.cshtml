@model TaskManagement.ViewModels.LoginViewModel

<div class="position-fixed top-0 start-0 w-100 h-100" style="background: url('/images/zzzz.webp') no-repeat center center; 
    background-size: cover; z-index: -1;"></div>

<div class="min-vh-100 d-flex align-items-center justify-content-center">
    <div class="rounded-4 shadow p-4 w-100 text-white" style="max-width: 420px; 
        background: linear-gradient(135deg, #081731ff);">
        <h3 class="mb-3 text-center text-white">Admin Login</h3>

        <form asp-action="AdminLogin" method="post">
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold">Email :</label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-bold">Password :</label>
                <input asp-for="Password" type="password" class="form-control" />
            </div>

            <button type="submit" class="btn btn-success w-100 fw-bold">Login as Admin</button>
        </form>
    </div>
</div>