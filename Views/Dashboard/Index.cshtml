@model IEnumerable<TaskManagement.Models.TaskItem>

@{
    ViewData["Title"] = "Admin Dashboard";
}

    <div class="sidebar text-white p-3 d-flex flex-column" style="background: linear-gradient(135deg, #081731, #0044cc); flex: 0 0 auto;">
        <h4 class="mb-4"><i class="bi bi-person-circle fs-1"></i> Admin</h4>    
        <hr/>
            <a asp-controller="Dashboard" asp-action="Index" asp-route-section="overview"
                class="d-block text-white mb-2 sidebar-link @(ViewBag.Section == "overview" ? "active" : "")" style="text-decoration: none;">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        <a asp-controller="Dashboard" asp-action="Index" asp-route-section="create"
                class="d-block text-white mb-2 sidebar-link @(ViewBag.Section == "create" ? "active" : "")" style="text-decoration: none;">
            <i class="bi bi-plus-lg"></i> Create Task
        </a>

        <a asp-controller="Dashboard" asp-action="Index" asp-route-section="assign"
                class="d-block text-white mb-2 sidebar-link @(ViewBag.Section == "assign" ? "active" : "")" style="text-decoration: none;">
            <i class="bi bi-plus-lg"></i> Assign Task
        </a>

        <a asp-controller="Dashboard" asp-action="Index" asp-route-section="TaskList"
                class="d-block text-white mb-2 sidebar-link @(ViewBag.Section == "TaskList" ? "active" : "")" style="text-decoration: none;">
            <i class="bi bi-list-task"></i> Tasks List
        </a>
        <a asp-controller="Dashboard" asp-action="Index" asp-route-section="list"
                class="d-block text-white mb-2 sidebar-link @(ViewBag.Section == "list" ? "active" : "")" style="text-decoration: none;">
            <i class="bi bi-list-task"></i> View Tasks Details
        </a>
        <a asp-controller="Dashboard" asp-action="Index" asp-route-section="users"
                class="d-block text-white mb-2 sidebar-link @(ViewBag.Section == "users" ? "active" : "")" style="text-decoration: none;">
            <i class="bi bi-people"></i> Users
        </a>
        <div class="mt-auto pt-4">
        <form asp-controller="Account" asp-action="Logout" method="post" class="mt-auto">
            @Html.AntiForgeryToken()
            <button type="submit" class="d-block text-white mb-2 sidebar-link logout-item" style="text-decoration: none;>
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </button>
        </form>
    </div>
    </div>

    <div class="main-content">

    @if (ViewBag.Section == "overview")
    {
        <h2 class="text-white mb-4">Dashboard Overview</h2>

        <div class="row g-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white text-center">  
                    <h6>Total Tasks</h6>
                    <i class="bi bi-backpack-fill fs-3"></i>
                    <h2>@ViewBag.TotalTasks</h2>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card bg-success text-white text-center">
                    <h6>Completed</h6>
                    <i class="bi bi-check-circle fs-3 "></i>
                    <h2>@ViewBag.Completed</h2>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card bg-warning text-white text-center">
                    <h6>Pending</h6>
                    <i class="bi bi-stopwatch-fill fs-3"></i>
                    <h2>@ViewBag.Pending</h2>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card bg-danger text-white text-center">
                    <h6>Overdue</h6>
                    <i class="bi bi-alarm-fill fs-3"></i>
                    <h2>@ViewBag.Overdue</h2>
                </div>
            </div>
            <div class="row g-4 mt-4" >
            <div class="col-md-3">
                <div class="card bg-info text-white text-center">
                    <h6>In Progress</h6>
                    <i class="bi bi-arrow-clockwise fs-3"></i>
                    <h2>@ViewBag.InProgress</h2>
                </div>
            </div>
        </div>
        </div>
    }

    @if (ViewBag.Section == "create")
    {
        <partial name="~/Views/Dashboard/Create.cshtml"
                model="new TaskManagement.Models.TaskItem()" />
    }

    else if (ViewBag.Section == "assign")
    {
        <partial name="~/Views/Dashboard/Assign.cshtml"
                model="new TaskManagement.Models.TaskItem()" />
    }

    else if (ViewBag.Section == "list")
    {
        <partial name="~/Views/Dashboard/TaskIndex.cshtml" model="Model.Where(t => t.AssignedToId != null).ToList()" />
    }

     else if (ViewBag.Section == "TaskList")
    {
        <partial name="~/Views/Dashboard/TaskList.cshtml" model="Model" />
    }

    else if (ViewBag.Section == "edit")
    {
    if (ViewBag.EditTask != null)
    {
        <partial name="~/Views/Dashboard/Edit.cshtml" model="ViewBag.EditTask" />
    }
    }
    else if (ViewBag.Section == "users")
    {
        <partial name="~/Views/UserDashboard/Indexes.cshtml" model="ViewBag.Users" />
    }

</div>

<style>
    .sidebar-link, .logout-item {
        padding: 10px 15px;
        border-radius: 8px;
        transition: all 0.3s ease;
        font-weight: 500;
        border: none;
        background: none;
        width: 100%;
        text-align: left;
    }
    
    .sidebar-link:hover, .logout-item:hover {
        background-color: rgba(255,255,255,0.1);
        transform: translateX(5px);
        color: white;
        text-decoration: none;
    }
    
    .sidebar-link.active {
        background-color: rgba(255,255,255,0.2);
        font-weight: bold;
    }
</style>
