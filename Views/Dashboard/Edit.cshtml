@model TaskManagement.Models.TaskItem

<div class="d-flex justify-content-center"  style="padding-top: 0px;">
    <div class="card rounded-4 shadow p-4 w-100 text-white" style="max-width: 500px; 
        background: linear-gradient(135deg, #081731, #0044cc);">

        <div class="card-body p-3">
            <form asp-controller="Dashboard" asp-action="Edit" method="post">
               <input type="hidden" asp-for="Id" />
                <div class="mb-2">
                    <label asp-for="Title" class="form-label fw-bold">Title:</label>
                    <input asp-for="Title" class="form-control" />
                </div>

                <div class="mb-2">
                    <label asp-for="Description" class="form-label fw-bold">Description:</label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>

                <div class="mb-2 row">
                    <div class="col">
                        <label asp-for="AssignDate" class="form-label fw-bold">Assign Date :</label>
                        <input type="date" asp-for="AssignDate" class="form-control" />
                    </div>
                    <div class="col">
                        <label asp-for="DueDate" class="form-label fw-bold">Due Date :</label>
                        <input type="date" asp-for="DueDate" class="form-control" />
                    </div>
                </div>

                <div class="mb-2 row">
                    <div class="col">
                        <label asp-for="Priority" class="form-label fw-bold">Priority:</label>
                        <select asp-for="Priority" class="form-select">
                            <option value="">------- Select -------</option>
                            <option>Low</option>
                            <option>Medium</option>
                            <option>High</option>
                        </select>
                    </div>
                    <div class="col">
                        <label asp-for="Status" class="form-label fw-bold">Status:</label>
                        <select asp-for="Status" class="form-select">
                            <option value="">------- Select -------</option>
                            <option>Pending</option>
                            <option>In Progress</option>
                            <option>Completed</option>
                        </select>
                    </div>
                </div>

                <div class="mb-2">
                    <label asp-for="AssignedToId" class="form-label fw-bold">Assign To:</label>
                    <select asp-for="AssignedToId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Users, "Id", "Name"))">
                        <option value="">-- Select User --</option>
                    </select>
                </div>

                <div class="d-flex justify-content-start gap-2">
                    <button type="submit" class="btn btn-success">Update</button>
                    <a asp-controller="Dashboard" asp-action="Index" asp-route-section="list" class="btn btn-outline-light">Back</a>
                </div>
            </form>
        </div>
    </div>

