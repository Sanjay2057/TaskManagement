@model TaskManagement.Models.TaskItem

@* <div class="position-fixed top-0 start-0 w-100 h-100" style="background: url('/images/zzzz.webp') no-repeat center center;
    background-size: cover; z-index: -1;"></div> *@

<div class="d-flex justify-content-center" style="padding-top: 0px;">
    <div class="card rounded-4 shadow p-4 w-100 text-white" style="max-width: 500px; 
        background: linear-gradient(135deg, #081731, #0044cc);">
            @* <h3 class="mb-1 text-center text-white">Create Task</h3> *@

        <div class="card-body p-3">
            <form asp-controller="Dashboard" asp-action="Assign" method="post">
                <div class="mb-2">
                    <label class="form-label fw-bold">Select Task :</label>
                    <select name="TaskId" class="form-select">
                        <option value="">------- Select -------</option>
                        @foreach (var task in ViewBag.Tasks)
                        {
                            <option value="@task.Id">@task.Title</option>
                        }
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-bold">Description :</label>
                    <textarea class="form-control" rows="2"></textarea>
                </div>

                <div class="mb-2 row">
                    <div class="col">
                        <label for="assignDate" class="form-label fw-bold">Assign Date :</label>
                        <input type="date" name="assignDate" id="dueDate" class="form-control" />
                    </div>
                    <div class="col">
                        <label for="dueDate" class="form-label fw-bold">Due Date :</label>
                        <input type="date" name="dueDate" id="dueDate" class="form-control" />
                    </div>
                </div>

                <div class="mb-2 row">
                    <div class="col">
                        <label class="form-label fw-bold">Priority :</label>
                        <select class="form-select">
                            <option value="">------- Select -------</option>
                            <option>Low</option>
                            <option>Medium</option>
                            <option>High</option>
                        </select>
                    </div>
                    <div class="col">
                        <label class="form-label fw-bold">Status :</label>
                        <select name="status" class="form-select">
                            <option value="">------- Select -------</option>
                            <option>Pending</option>
                            <option>In Progress</option>
                            <option>Completed</option>
                        </select>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-bold">Assign To :</label>
                    <select name="UserId" class="form-select">
                        <option value="">------- Select -------</option>
                        @foreach (var user in ViewBag.Users)
                        {
                            <option value="@user.Id">@user.Name</option>
                        }
                    </select>
                </div>

                <div class="d-flex justify-content-start gap-2">
                    <button type="submit" class="btn btn-success">Assign Task</button>
                    <a asp-action="Index" class="btn btn-outline-light">Back</a>
                </div>
            </form>
        </div>
    </div>
@* </div> *@
