@model IEnumerable<TaskManagement.Models.TaskItem>

<div class="container mt-2">
    <h2 class="mb-2 text-white">Tasks List</h2>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Create Date</th>
                    <th>Priority</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                    @foreach(var task in Model)
                    {
                        <tr>
                            <td class="text-white">@task.Title</td>
                            <td class="text-white">@task.Description</td>
                            <td class="text-white">@task.CreateDate.ToShortDateString()</td>  
                            <td class="text-white">@task.Priority</td>
                            <td><a href="/Dashboard/Delete/@task.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash3"></i></a></td>
                        </tr>
                    }
            </tbody>
        </table>
    </div>
</div>
